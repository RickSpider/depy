<?page title="recibocion" contentType="text/html;charset=UTF-8"?>


<zk>
	<window border="normal"
		viewModel="@id('vm') @init('com.depy.sistema.operacion.EReciboVM')"
		vflex="1" id="Body" apply="org.zkoss.bind.BindComposer">
		
		<caption  >
		
			<label value="Emision de Recibo - " style="font-weight:bold"/>
			<label value="@load(vm.sucursalStr)" style="font-weight:bold"/>
		
		</caption>
		
		<hlayout>
		
			<tablelayout columns="6">
				<tablechildren>
					<label value="RUC/Doc #:" style="font-weight:bold" />
				</tablechildren>

				<tablechildren>
					<hlayout>
						<searchbox model="@load(vm.lClienteSM)"
							placeholder="Seleccione un Cliente" vflex="1" 
							selectedItem="@bind(vm.clienteSMSelected)" autoclose="true"
							multiple="false" onSelect="@command('onSelectedCliente')">
							<template name="model">

								${each.documentoNro} |
								${each.razonSocial}

							</template>

						</searchbox>
						<!-- <button iconSclass=" z-icon-plus" class="doxa-button-green"
							onClick="@command('crearCliente')" tooltiptext="Agregar Cliente" /> -->
					</hlayout>

				</tablechildren>

				<tablechildren>
					<label value="Razon Social:"
						style="font-weight:bold" />
				</tablechildren>

				<tablechildren colspan="3">
					<textbox
						value="@load(vm.reciboSelected.razonSocial)" readonly="true"
						hflex="1" />
				</tablechildren>

				<tablechildren>
					<label value="Direccion:" style="font-weight:bold" />
				</tablechildren>

				<tablechildren colspan="3">
					<textbox
						value="@load(vm.reciboSelected.direccion)" readonly="true"
						hflex="1" />
				</tablechildren>				
				
				<tablechildren>
					<label value="Fecha:"
						style="font-weight:bold" />
				</tablechildren>

				<tablechildren>
					<datebox valueInLocalDateTime="@bind(vm.reciboSelected.fecha)" format="dd/MM/yyy HH:mm:ss" width="180px"/>					
				</tablechildren>
				
				<tablechildren>
					<label value="Moneda:" style="font-weight:bold" />
				</tablechildren>

				<tablechildren>
					<combobox width="150px" readonly="true"
						model="@load(vm.lMoneda)"
						selectedItem="@bind(vm.reciboSelected.moneda)"
						onChange="">
						
						<template name="model">
							<comboitem label="@load(each.tipo)" />
						</template>

					</combobox>
				</tablechildren>
				
				<tablechildren>
					<label value="Moneda Cambio:"
						style="font-weight:bold" />
				</tablechildren>

				<tablechildren>
					<doublebox
						value="@bind(vm.reciboSelected.monedaCambio)" readonly="@load((vm.reciboSelected.moneda.tipo.equals('PYG')))"/>
				</tablechildren>

			</tablelayout>
			
			<hbox hflex="1" align="end" pack="end">
			
				<button class="doxa-button-orange" onClick="@command('recibosModal')" 
				label="Recibos" iconSclass="fa-solid fa-file-lines"/>
			
			</hbox>
			
		</hlayout>
		
		

		<hlayout vflex="1" hflex="1">
			<listbox vflex="1" hflex="1"
				model="@load(vm.reciboSelected.detalles)">
				<listhead>

					<listheader label="Factura #" hflex="min" />
					<listheader label="Descripcion" />
					<listheader label="Importe" hflex='min' />
					<listheader hflex='min' >
						<button onClick="@command('buscarFacturaModal', detalle=each)" iconSclass=" z-icon-plus" class="doxa-button-green"  tooltiptext="Agregar Factura" />
					</listheader>

				</listhead>
				<template name="model">


					<listitem>
					
						<listcell>
							<hbox>
								<textbox value="@bind(each.factura.timbradoDocNro)"  maxlength="120" readonly="true"/>
							</hbox>							
						</listcell>
						
						<listcell>
							<textbox value="@bind(each.itemDescripcion)" hflex="1" maxlength="120"/>
						</listcell>
						
					
						<listcell>
							<doublebox width="100px" value="@bind(each.importe)"
								style="text-align:right" format="#,###.##" onChange="@command('calcularTotales')" />
						</listcell>
						
						<listcell>

							<button iconSclass="z-icon-trash-o" onClick="@command('borrarDetalle', detalle=each)"
								class="doxa-button-red" tooltiptext="Borrar" />

						</listcell>
					</listitem>

				</template>

			</listbox>

			<vlayout vflex="2">



				<tablelayout columns="2">
				
					<!--  <tablechildren>
						<label value="Forma Pago:" />
					</tablechildren>
					<tablechildren>
						<textbox value="@load(vm.reciboSelected.pagos.get(0).pagoTipo.tipo)" readonly="true" width="100px" style="font-weight: bold;"/>
					</tablechildren>-->

					<tablechildren>
						<label value="Total:" />
					</tablechildren>
					<tablechildren>
						<doublebox format="#,###.##" value="@load(vm.totalDetalle)"
							style="font-weight: bold; text-align:right;" readonly="true" width="100px"/>
					</tablechildren>

					

				</tablelayout>

				<hlayout>

					<button label="Generar Recibo"
						style="background-color:green" onClick="@command('generarRecibo')" disabled="@load(!vm.btnGenerar)"/>
					
					<button onClick="@command('limpiarPantalla')"
						label="LIMPIAR" />

				</hlayout>

			</vlayout>

		</hlayout>

	</window>
	
</zk>