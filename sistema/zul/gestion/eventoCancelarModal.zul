<?page title="Cancelar" contentType="text/html;charset=UTF-8"?>
<zk>

<window border="normal"
		position="center,center" closable="true" mode="modal"
		action="show: slideDown;hide: slideUp" width="600px">
		
		<caption label="Cancelacion" style="font-weight:bold"/>

	<tablelayout 
		columns="2">

		<tablechildren>

			<label value="CDC:" style="font-weight:bold" />

		</tablechildren>

		<tablechildren>

			<textbox value="@load(vm.eventoSelected.cdc)"
				readonly="true" width="350px" />

		</tablechildren>

		<tablechildren>

			<label value="Motivo:" style="font-weight:bold" />

		</tablechildren>

		<tablechildren>

			<textbox value="@bind(vm.eventoSelected.motivo)"
				width="350px" />

		</tablechildren>

	</tablelayout>
	
		<space height="10px" />
		
		<hlayout>

			<button label="Aceptar" onClick="@command('generarEvento')" />

		</hlayout>

</window>

</zk>