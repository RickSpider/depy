<h:div class="invoice-card" data-status="${inv.status}">
    <h:div class="card-stripe ${s.cls}"></h:div>
    <h:div class="card-body">
      <h:div class="card-number-label">N° Factura</h:div>
      <h:div class="card-number">${inv.id}</h:div>
      <h:div class="card-date">
       <html><![CDATA[
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        ]]></html>
        ${inv.date}
      </h:div>
      <h:div class="card-client">
        <h:div class="client-dot">${initials(inv.client)}</h:div>
        <h:div>
          <h:div class="client-name">${inv.client}</h:div>
          <h:div class="client-ruc">RUC: ${inv.ruc}</h:div>
        </h:div>
      </h:div>
      <h:div class="card-divider"></h:div>
      <h:div class="card-amount-row">
        <h:div>
          <h:div class="card-amount-label">Total</h:div>
          <h:div class="card-amount">${inv.amount}</h:div>
        </h:div>
        <h:span class="status-badge ${s.cls}">
          <h:span class="status-dot"></h:span>${s.label}
        </h:span>
      </h:div>
    </h:div>
    <h:div class="card-actions">
      <h:button class="btn-icon btn-cancel" onclick="showToast('Anulando ${inv.id}…')">
       <html><![CDATA[
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        ]]></html>
        Anular
      </h:button>
      <h:button class="btn-icon btn-doc" onclick="showToast('Abriendo ${inv.id}…')">
       <html><![CDATA[
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        ]]></html>
        Ver
      </h:button>
    </h:div>
  </h:div>