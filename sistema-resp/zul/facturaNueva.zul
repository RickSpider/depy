<?page title="facturaNueva" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml">

	<h:div>

				<!-- Header -->

				<h:div class="form-header">
					<h:div class="form-header-inner">
						<h:div>
							<h:div class="page-label">Nueva</h:div>
							<h:div class="page-title"
								style="font-size:22px">
								Emisión de Factura
							</h:div>
							<h:div class="page-meta">
								Complete los datos del comprobante
							</h:div>
						</h:div>
						<h:button class="back-btn"
							onClick="@command('cambiarPantalla', pantalla=0)">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"> <line x1="19"
								y1="12" x2="5" y2="12"/> <polyline
								points="12 19 5 12 12 5"/> </svg> ]]>
							</html>
							Volver
						</h:button>
					</h:div>

				</h:div>

				<h:div class="form-body">

					<!-- ── CARD 1: DATOS GENERALES ── -->
					<h:div class="form-card">
						<h:div class="form-card-header">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"> <path d="M20
								14.66V20a2 2 0 0 1-2 2H4a2 2 0 0
								1-2-2V6a2 2 0 0 1 2-2h5.34"/> <polygon
								points="18 2 22 6 12 16 8 16 8 12 18
								2"/> </svg> ]]>
							</html>
							<h:span class="form-card-title">
								Datos del Receptor
							</h:span>
						</h:div>
						<h:div class="form-card-body">

							<!-- RUC -->
							<h:div class="form-row cols-2"
								style="margin-bottom:14px">
								<h:div class="form-group">
									<h:label class="form-label">
										RUC / C.I. Cliente
										<h:span class="required">
											*
										</h:span>
									</h:label>
									<h:div class="input-with-prefix">
										
										<!--  <textbox value="@bind(vm.facturaSelected.documentoNro)" class="form-control"
											placeholder="80012345-6" onChange="@command('onChangeDoc')" height="38px"
											/> -->
											
										<searchbox model="@load(vm.lClienteSM)" class="form-control"
											placeholder="Seleccione un Cliente" height="38px"
											selectedItem="@bind(vm.clienteSMSelected)" autoclose="true"
											multiple="false"  >
											<template name="model">
				
												${each.documentoNro} |
												${each.razonSocial}
				
											</template>
				
										</searchbox>
										
										<h:button class="btn-icon btn-doc"
											onClick="@command('cambiarPantalla', pantalla=2)">
											<html>
												<![CDATA[ <svg viewBox="0 0 24 24"
												fill="none" stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"> <line
												x1="12" y1="5" x2="12" y2="19"/>
												<line x1="5" y1="12" x2="19"
												y2="12"/> </svg> ]]>
											</html>
											
										</h:button>
										
									</h:div>
									
									
								</h:div>
								
								<h:div class="form-group">
									
						            <h:label class="form-label">Fecha <h:span class="required">*</h:span></h:label>

							        <datebox valueInLocalDateTime="@bind(vm.facturaSelected.fecha)" format="dd/MM/yyyy"  sclass="custom-datebox" readonly="true"/>
							         
						          </h:div>
								
							</h:div>

							<!-- Razón social -->
							<h:div class="form-row"
								style="margin-bottom:14px">
								<h:div class="form-group">
									<h:label class="form-label">
										Razón Social / Nombre
										<h:span class="required">
											*
										</h:span>
									</h:label>
									<h:div class="input-with-prefix">
									
										<textbox value="@load(vm.clienteSMSelected.razonSocial)" class="form-control" placeholder="Nombre del cliente o empresa..." height="38px" readonly="true"/>
									</h:div>
								</h:div>
							</h:div>
							
							<!-- Email -->
							<h:div class="form-row"
								style="margin-bottom:14px">
								<h:div class="form-group">
									<h:label class="form-label">
										Email
									</h:label>
									<h:div class="input-with-prefix">
									
										<textbox value="@bind(vm.clienteSMSelected.email)" class="form-control" placeholder="mail@mail.com..." height="38px" readonly="true"/>
									</h:div>
								</h:div>
							</h:div>

						

						</h:div>
					</h:div>

					<!-- ── CARD 2: CONDICIONES ── -->
					<h:div class="form-card">
						<h:div class="form-card-header">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"> <rect x="1"
								y="4" width="22" height="16" rx="2"
								ry="2"/> <line x1="1" y1="10" x2="23"
								y2="10"/> </svg> ]]>
							</html>
							<h:span class="form-card-title">
								Condiciones de Pago
							</h:span>
						</h:div>
						<h:div class="form-card-body">

							<h:div class="form-row"
								style="margin-bottom:14px">

								<!-- Condición -->
								<h:div class="form-group">
									<h:label class="form-label">
										Condición
										<h:span class="required">
											*
										</h:span>
									</h:label>
									
									<h:div class="toggle-group">
										<h:button
											class="toggle-btn active" id="btnContado"
											onClick="@command('onChangeCondicion', id=self.id)">
											Contado
										</h:button>
										<h:button class="toggle-btn"
											id="btnCredito" onClick="@command('onChangeCondicion', id=self.id)">
											Crédito
										</h:button>
									</h:div>									
									
									
								</h:div>
							</h:div>

							<!-- Crédito: plazo (condicional) -->
							<h:div class="conditional-field"
								id="creditoFields">
								<h:div class="form-row cols-2">
									<h:div class="form-group">
										<h:label class="form-label">
											Plazo
											<h:span class="required">
												*
											</h:span>
										</h:label>
										<!-- <h:input class="form-control"
											type="number" id="plazoInput" min="1" placeholder="30"
											oninput="this.value=this.value.replace(/[^0-9]/g,'')" /> -->
											
											<textbox class="form-control" height="34px"
											value="@bind(vm.facturaSelected.plazoCredito)" placeholder="30"/>
											
									</h:div>
									<h:div class="form-group">
										<h:label class="form-label">
											Unidad
											<h:span class="required">
												*
											</h:span>
										</h:label>
										
										<combobox sclass="custom-combobox" 
											
											selectedItem="@bind(vm.cbPlazo)" readonly="true" >
										    <comboitem label="Dias" value="dias" />
										    <comboitem label="Meses" value="meses"/>
										</combobox>
										
										<!-- <h:select class="form-control"
											id="plazoUnidad">
											<h:option value="dias">
												Días
											</h:option>
											<h:option value="meses">
												Meses
											</h:option> 
										</h:select>-->
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>

					<!-- ── CARD 3: MONEDA ── -->
					<h:div class="form-card">
						<h:div class="form-card-header">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"> <circle cx="12"
								cy="12" r="10"/> <line x1="12" y1="8"
								x2="12" y2="12"/> <line x1="12" y1="16"
								x2="12.01" y2="16"/> </svg> ]]>
							</html>
							<h:span class="form-card-title">
								Moneda
							</h:span>
						</h:div>
						<h:div class="form-card-body">

							<h:div class="form-row">
								<h:div class="form-group">
									<h:label class="form-label">
										Moneda
										<h:span class="required">
											*
										</h:span>
									</h:label>
									<h:div class="currency-toggle">
										<h:button
											class="currency-btn active" id="btnPyg"
											onClick="@command('onChangeMoneda', id=self.id)">
											₲ Guaraní
										</h:button>
										<h:button class="currency-btn"
											id="btnUsd" onClick="@command('onChangeMoneda', id=self.id)">
											$ Dólar
										</h:button>
									</h:div>
								</h:div>

								<!-- Tipo de cambio (solo visible para USD) -->
								<h:div
									class="form-group conditional-field" id="tipoCambioGroup">
									<h:label class="form-label">
										Tipo de Cambio
										<h:span class="required">
											*
										</h:span>
									</h:label>
									<h:div class="input-with-prefix">
										<!-- <h:span class="input-prefix">
											₲ /US$
										</h:span>
										<h:input class="form-control"
											type="text" id="tipoCambio" placeholder="7.500"
											oninput="this.value=this.value.replace(/[^0-9\.]/g,''); recalcAll();" /> -->
											
										<doublebox  value="@bind(vm.facturaSelected.monedaCambio)" class="form-control" height="37px"/>	
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>

					<!-- ── CARD 4: ÍTEMS ── -->
					<h:div class="form-card">
						<h:div class="form-card-header">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"> <line x1="8"
								y1="6" x2="21" y2="6"/> <line x1="8"
								y1="12" x2="21" y2="12"/> <line x1="8"
								y1="18" x2="21" y2="18"/> <line x1="3"
								y1="6" x2="3.01" y2="6"/> <line x1="3"
								y1="12" x2="3.01" y2="12"/> <line x1="3"
								y1="18" x2="3.01" y2="18"/> </svg> ]]>
							</html>
							<h:span class="form-card-title">
								Detalle de Ítems
							</h:span>
						</h:div>

						<!-- TABLE -->
						<h:div class="items-table-wrap">
							<h:table class="items-table">
								<h:thead>
									<h:tr>
										<!-- <h:th style="width:100px">
											Código
										</h:th>  -->
										<h:th>Descripción</h:th>
										<h:th
											style="width:110px; text-align:right">
											P. Unitario
										</h:th>
										<h:th
											style="width:80px; text-align:right">
											Cantidad
										</h:th>
										<h:th style="width:90px">
											IVA
										</h:th>
										<h:th
											style="width:120px; text-align:right">
											Total
										</h:th>
										<h:th style="width:46px"></h:th>
									</h:tr>
								</h:thead>
								<h:tbody id="itemsBody" children="@load(vm.facturaSelected.detalles)">
									
									<template name="children">
										<h:tr class="item-row">
											<!--  <h:td class="col-code" data-label="Código"><textbox value ="@bind(each.itemCodigo)" class="cell-input" type="text" placeholder="COD-001" style="width:90px"/></h:td>-->
										    <h:td class="col-desc" data-label="Descripción"><textbox value ="@bind(each.itemDescripcion)" class="cell-input" type="text" placeholder="Descripción del producto o servicio" style="min-width:200px"/></h:td>
										    <h:td class="col-price" data-label="P. Unitario"><doublebox onChange="@command('calcularTotales', detalle=each)"  value ="@bind(each.precioUnitario)" format="#,###.##" class="cell-input"  style="width:100px;text-align:right"/></h:td>
										    <h:td class="col-qty" data-label="Cantidad"><doublebox onChange="@command('calcularTotales', detalle=each)" value ="@bind(each.cantidad)" class="cell-input"  format="#,###.##" style="text-align:right;" /></h:td>
										    <h:td class="col-iva" data-label="IVA">
										    
											    <combobox readonly="true" 
													model="@load(vm.lIva)"
													selectedItem="@bind(each.tasaIva)"
													onChange="@command('onChangeIva', detalle=each)">
													<template name="model" var="x">
														<comboitem label="@load(x eq 0 ? 'Exento' : x)" value="@load(x)"/>
													</template>
												</combobox>
										    
										      <!--  <h:select class="cell-input" style="width:80px" onchange="calcRow(${id})">
										        <h:option value="10">10%</h:option>
										        <h:option value="5">5%</h:option>
										        <h:option value="0">Exento</h:option>
										      </h:select> -->
										    </h:td >
										    	<h:td class="col-total" data-label="Total" >
										    		<doublebox class=" cell-input" style="width:100px; text-align:right;"
															format="#,###.##" value="@load((each.cantidad*each.precioUnitario))" 
															readonly="true" />
												</h:td>
										    <h:td  class="col-del">
										      <h:button class="btn-row-delete"  title="Eliminar fila" onClick="@command('borrarDetalle', data=each)">
										      <html><![CDATA[
										        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										          <polyline points="3 6 5 6 21 6"/>
										          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
										          <path d="M10 11v6"/><path d="M14 11v6"/>
										          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
										        </svg>
										        ]]></html>
										      </h:button>
										    </h:td>
										</h:tr>
									</template>
									
								
									<!-- rows injected by JS -->
								</h:tbody>
							</h:table>
						</h:div>

						<!-- ADD ROW -->
						<h:div class="add-row-wrap">
							<h:button class="btn-add-row"
								onClick="@command('agregarDetalle')">
								<html>
									<![CDATA[ <svg viewBox="0 0 24 24"
									fill="none" stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"> <line
									x1="12" y1="5" x2="12" y2="19"/>
									<line x1="5" y1="12" x2="19"
									y2="12"/> </svg> ]]>
								</html>
								Agregar ítem
							</h:button>
						</h:div>

						<!-- TOTALES -->
						<h:div
							style="padding:18px; border-top:1px solid var(--gray-100);">
							<h:div
								style="display:flex; justify-content:flex-end;">
								<h:div class="totals-panel">
									<h:div class="totals-row">
										<h:span>IVA 10%</h:span>
										<h:span id="totalIva10">
											<label 
											value="@load(vm.iva10) @converter('formatedNumber', format='#,##0.##', locale='es_PY')" class="totals-final-value" />
										</h:span>
									</h:div>
									<h:div class="totals-row">
										<h:span>IVA 5%</h:span>
										<h:span id="totalIva5">
											<label 
											value="@load(vm.iva5) @converter('formatedNumber', format='#,##0.##', locale='es_PY')" class="totals-final-value" />
										</h:span>
									</h:div>
									<h:div class="totals-row">
										<h:span>Exento</h:span>
										<h:span id="totalExento">
											<label 
											value="@load(vm.iva0) @converter('formatedNumber', format='#,##0.##', locale='es_PY')" class="totals-final-value" />
										</h:span>
									</h:div>
									<h:div class="totals-final">
										<h:span
											class="totals-final-label">
											Total General
										</h:span>
										<h:span
											 id="totalGeneral">
											<label 
											value="@load(vm.facturaSelected.totalDetalle) @converter('formatedNumber', format='#,##0.##', locale='es_PY')" class="totals-final-value" />
										</h:span>
									</h:div>
								</h:div>
							</h:div>
						</h:div>

					</h:div><!-- /card items -->

					<!-- ── ACTIONS ── -->
					<h:div class="form-actions">
						<h:button class="btn-danger"
							onClick="@command('cambiarPantalla', pantalla=0)">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"
								style="width:18px;height:18px"> <line
								x1="18" y1="6" x2="6" y2="18"/> <line
								x1="6" y1="6" x2="18" y2="18"/> </svg>
								]]>
							</html>
							Salir
						</h:button>
						<!--  <h:button class="btn-secondary"
							onclick="showToast('Borrador guardado')">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"
								style="width:18px;height:18px"> <path
								d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1
								2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
								<polyline points="17 21 17 13 7 13 7
								21"/> <polyline points="7 3 7 8 15 8"/>
								</svg> ]]>
							</html>
							Guardar borrador
						</h:button>-->
						<h:button class="btn-primary"
							onClick="@command('procesarFactura')">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								style="width:18px;height:18px;fill:none">
								<polyline points="20 6 9 17 4 12"/>
								</svg> ]]>
							</html>
							Facturar
						</h:button>
					</h:div>
				</h:div><!-- /form-body -->
			</h:div>

</zk>