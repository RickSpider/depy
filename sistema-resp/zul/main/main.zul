<?page title="main" contentType="text/html;charset=UTF-8"?>
<zk  xmlns:h="http://www.w3.org/1999/xhtml">

		<!-- HOME SPLASH — pantalla por defecto -->
		<h:div class="div active" id="div-home">
			<h:div class="home-splash">
				<h:div class="home-grid-bg"></h:div>
				<h:div class="home-content">

					<h:div class="home-logo-wrap">
						<h:div
							class="home-logo-ring home-logo-ring-1">
						</h:div>
						<h:div
							class="home-logo-ring home-logo-ring-2">
						</h:div>
						<h:div
							class="home-logo-ring home-logo-ring-3">
						</h:div>
						<h:div class="home-logo-box">
							<html>
								<![CDATA[ <svg viewBox="0 0 48 48"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
								width="66" height="66"> <defs>
								<linearGradient id="depyGrad" x1="0"
								y1="0" x2="1" y2="1"> <stop offset="0%"
								stop-color="#38bdf8"/> <stop
								offset="100%" stop-color="#0284c7"/>
								</linearGradient> </defs> <path d="M10
								6C10 4.9 10.9 4 12 4H30L38 12V42C38 43.1
								37.1 44 36 44H12C10.9 44 10 43.1 10
								42V6Z" fill="url(#depyGrad)"
								opacity=".15"/> <path d="M10 6C10 4.9
								10.9 4 12 4H30L38 12V42C38 43.1 37.1 44
								36 44H12C10.9 44 10 43.1 10 42V6Z"
								stroke="url(#depyGrad)" stroke-width="2"
								fill="none"/> <path d="M30 4L38
								12H32C30.9 12 30 11.1 30 10V4Z"
								fill="url(#depyGrad)" opacity=".5"/>
								<line x1="16" y1="20" x2="32" y2="20"
								stroke="url(#depyGrad)" stroke-width="2"
								stroke-linecap="round"/> <line x1="16"
								y1="26" x2="32" y2="26"
								stroke="url(#depyGrad)" stroke-width="2"
								stroke-linecap="round"/> <line x1="16"
								y1="32" x2="26" y2="32"
								stroke="url(#depyGrad)" stroke-width="2"
								stroke-linecap="round"/> <circle cx="33"
								cy="36" r="7" fill="#0c2d48"
								stroke="url(#depyGrad)"
								stroke-width="1.5"/> <text x="33" y="40"
								text-anchor="middle" font-size="9"
								font-weight="bold" fill="#38bdf8"
								font-family="monospace">₲</text> </svg>
								]]>
							</html>
						</h:div>
					</h:div>

					<h:div class="home-brand-name">DE<h:span class="accent">PY</h:span></h:div>
					<h:div class="home-brand-full">
						Documentos Electrónicos Paraguay
					</h:div>

					<h:div class="home-pills">

						<h:span class="home-pill">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"> <path d="M14
								2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2
								2 0 0 0 2-2V8z"/> <polyline points="14 2
								14 8 20 8"/> </svg> ]]>
							</html>
							Facturación electrónica
						</h:span>
						<h:span class="home-pill">

							<html>
								<![CDATA[

								<svg viewBox="0 0 24 24" fill="none"
								stroke="currentColor" stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"> <rect x="3"
								y="11" width="18" height="11" rx="2"
								ry="2"/> <path d="M7 11V7a5 5 0 0 1 10
								0v4"/> </svg> ]]>
							</html>
							Firma digital
						</h:span>
						<h:span class="home-pill">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2" stroke-linecap="round"
								stroke-linejoin="round"> <polyline
								points="22 12 18 12 15 21 9 3 6 12 2
								12"/> </svg> ]]>
							</html>
							Tiempo real SET
						</h:span>
					</h:div>

					<h:div class="home-cta">
						<h:div class="home-cta-label">
							Abrir el menú para comenzar
						</h:div>
						<h:a class="home-cta-btn" href="#"
							onclick="document.getElementById('hamburgerBtn').click(); return false;">
							<html>
								<![CDATA[ <svg viewBox="0 0 24 24"
								fill="none" stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"> <line x1="3"
								y1="6" x2="21" y2="6"/> <line x1="3"
								y1="12" x2="21" y2="12"/> <line x1="3"
								y1="18" x2="21" y2="18"/> </svg> ]]>
							</html>
							Abrir menú
						</h:a>
					</h:div>

				</h:div>
				<h:div class="home-version">DEPY v2.0 · 2026</h:div>
			</h:div>
		</h:div>

</zk>