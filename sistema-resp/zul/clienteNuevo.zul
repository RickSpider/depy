<?page title="ClienteNuevo" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml">

	<h:div class="form-header">
		<h:div class="form-header-inner">
			<h:div>
				<h:div class="page-h:label">Nuevo</h:div>
				<h:div class="page-title" style="font-size:22px">
					Alta de Cliente
				</h:div>
				<h:div class="page-meta">
					Complete los datos del cliente
				</h:div>
			</h:div>
			<h:button class="back-btn"
				onClick="@command('cambiarPantalla', pantalla=1)">
				<html>

					
					<![CDATA[ <svg viewBox="0 0 24 24" fill="none"
					stroke="currentColor" stroke-width="2"
					stroke-linecap="round" stroke-linejoin="round">
					<line x1="19" y1="12" x2="5" y2="12"/> <polyline
					points="12 19 5 12 12 5"/> </svg> ]]>

					</html>
				Volver
			</h:button>
		</h:div>

	</h:div>

	<h:div class="form-body">

		<!-- ── SECCIÓN: Identificación ── -->
		<h:div class="form-card">
			<h:div class="form-card-header">
				<html>
					
					<![CDATA[ <svg viewBox="0 0 24 24" fill="none"
					stroke="currentColor" stroke-width="2"
					stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="5" width="20" height="14" rx="2"/>
					<line x1="2" y1="10" x2="22" y2="10"/> </svg> ]]>
					
								</html>
				<h:span class="form-card-title">Datos del Contribuyente</h:span>
			</h:div>
			<h:div class="form-card-body">

				<!-- Tipo de documento + N° documento -->
				<h:div class="form-row cols-2"
					style="margin-bottom:14px">
					<h:div class="form-group">
						<h:label class="form-label">
							N° Documento
							<h:span class="required">*</h:span>
						</h:label>
						<textbox class="form-control" height="34px"
							 placeholder="80012345-6" 
							 value="@bind(vm.clienteSelected.documentoNro)"
							 onChange="@command('onChangeDoc')"/>
						
					</h:div>
					<h:div class="form-group">
					
					<h:label class="form-label">
							Tipo Documento
							<h:span class="required">*</h:span>
						</h:label>
						
							<combobox readonly="true" sclass="custom-combobox" 
								model="@load(vm.lDocumentoTipo)"
								selectedItem="@bind(vm.clienteSelected.documentoTipo)">
								
								<template name="model">
									<comboitem label="@load(each.tipo)" />
								</template>
							</combobox>
					
					
						
					</h:div>
				</h:div>

				<h:div class="form-row">
					<h:div class="form-group">
						<h:label class="form-label">
							Razón Social / Nombre
							<h:span class="required">*</h:span>
						</h:label>
						<textbox class="form-control" height="34px"
							placeholder="Nombre o empresa" 
							value="@bind(vm.clienteSelected.razonsocial)"/>
					</h:div>
				</h:div>

			</h:div>
		</h:div>
		
		<h:div class="form-card">
			<h:div class="form-card-header">
				<html>
					
					<![CDATA[ <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.5a16 16 0 0 0 6.58 6.58l.97-.97a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
		            </svg> ]]>
					
								</html>
				<h:span class="form-card-title">Contacto</h:span>
			</h:div>
			<h:div class="form-card-body">

				<!-- Celular Telefono -->
				<h:div class="form-row cols-2"
					style="margin-bottom:14px">
					<h:div class="form-group">
						<h:label class="form-label">
							Celular
							
						</h:label>
						<textbox class="form-control" height="34px"
							 placeholder="09XX654321" 
							 value="@bind(vm.clienteSelected.celular)" />
						
					</h:div>
					<h:div class="form-group">
					
					<h:label class="form-label">
							Telefono
							
						</h:label>
						
						<textbox class="form-control" height="34px"
							 placeholder="021654321" 
							 value="@bind(vm.clienteSelected.telefono)" />

					</h:div>
				</h:div>

				<h:div class="form-row">
					<h:div class="form-group">
						<h:label class="form-label">
							Correo Electronico
							
						</h:label>
						<textbox class="form-control" height="34px"
							placeholder="algo@dominio.com" 
							value="@bind(vm.clienteSelected.email)" />
					</h:div>
				</h:div>

			</h:div>
		</h:div>
		
		<h:div class="form-actions">
		
			<h:button class="btn-danger" onClick="@command('cambiarPantalla', pantalla=1)">
			
			<html>
					
					<![CDATA[
			
	        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px">
	          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
	        </svg>]]>
			        </html>
	        Cancelar
	      </h:button>
	      <h:button class="btn-primary" onClick="@command('guardarCliente')">
	      	<html>
					
					<![CDATA[ 
	        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;fill:none">
	          <polyline points="20 6 9 17 4 12"/>
	        </svg> ]]>
	        </html>
	        Guardar cliente
	      </h:button>
		</h:div>

	</h:div>

</zk>